# Database Configuration
# DATABASE_URL uses the Supabase transaction pooler:
# postgresql://postgres.hokmyvmbogqtnpsjidav:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=certs%2Fsupabase-prod-ca-2021.crt
# Supabase transaction pooler for the application (serverless).
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=verify-full

# Supabase session pooler for IPv4-compatible backups/restores:
# Use the session pooler for IPv4-compatible restores:
# postgresql://postgres.hokmyvmbogqtnpsjidav:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs%2Fsupabase-prod-ca-2021.crt
# BACKUP_DATABASE_URL=postgresql://username:password@direct-host:port/database?sslmode=require

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# Backup Configuration
BACKUP_PATH=path/to/backup/directory

# PostgreSQL Bin Path (for pg_dump)
POSTGRES_BIN_PATH=C:\Program Files\PostgreSQL\18\bin

# Email Configuration (for password reset, notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@example.com

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Persistent file storage for production uploads (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=

# Optional: Rate Limiting (if using Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
